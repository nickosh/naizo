{
  "name": "nakajs",
  "version": "0.1.0",
  "description": "Self-persisting HTML inner database (#nakadb) and declarative list repeater for Human + AI Agent workflows.",
  "keywords": [
    "ai-agents",
    "file-system-access-api",
    "html",
    "local-first",
    "micro-db",
    "nakadb",
    "nakajs",
    "self-saving-html"
  ],
  "license": "MIT",
  "author": "Nikolay Shishov (https://github.com/nickosh)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickosh/nakajs.git"
  },
  "homepage": "https://github.com/nickosh/nakajs#readme",
  "bugs": {
    "url": "https://github.com/nickosh/nakajs/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/naka.js",
  "jsdelivr": "./dist/naka.js",
