    "./naka.js": "./dist/naka.js",
    "./naka.min.js": "./dist/naka.min.js",
    "./dist/naka.js": "./dist/naka.js",
    "./dist/naka.min.js": "./dist/naka.min.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp dev",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "pack": "vp pack",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite-plus": "^1.3.0"
  }
}
